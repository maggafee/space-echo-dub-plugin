{
  "kit": "amber",
  "pages": [
    { "name": "ECHO",
      "controls": [
        { "param": "Delay Time", "widget": "knob" },
        { "param": "Feedback",   "widget": "knob" },
        { "param": "Echo Level", "widget": "knob" },
        { "param": "Reverb",     "widget": "knob" },

        { "param": "Input",      "widget": "knob" },
        { "param": "Bass",       "widget": "knob", "polarity": "bipolar" },
        { "param": "Treble",     "widget": "knob", "polarity": "bipolar" },
        { "param": "Tape Sat",   "widget": "knob" },

        { "param": "Echo Mode",  "widget": "slider", "overlay": "menu" },
        { "param": "Tempo Sync", "widget": "switch" },
        { "param": "Sync Note",  "widget": "slider", "overlay": "menu" },
        { "param": "Stereo",     "widget": "switch" },

        { "param": "Dub Throw",  "widget": "switch" },
        { "param": "Hold",       "widget": "switch" },
        { "param": "Spring Kick","widget": "switch" },
        { "param": "Power",      "widget": "switch" }
      ] },
    { "name": "TAPE",
      "controls": [
        { "param": "Wow Flutter", "widget": "knob" },
        { "param": "Tape Age",    "widget": "knob" },
        { "param": "Inertia",     "widget": "knob" },
        { "param": "Spring Decay","widget": "knob" },

        { "param": "Low Cut",     "widget": "knob" },
        { "param": "Ducking",     "widget": "knob" },
        { "param": "Dry Level",   "widget": "fader" },
        { "param": "Output",      "widget": "fader", "polarity": "bipolar" },

        { "param": "Input Jack",  "widget": "switch" },
        { "param": "Send Mode",   "widget": "switch" },
        "empty",
        "empty"
      ] }
  ]
}
